{
  "manifest_version": 3,
  "name": "LCU Chrome Control",
  "version": "0.2.1",
  "description": "D3 product Chrome surface: debugger/CDP, Native Messaging, task tab groups, tab lease. No Playwright, no AX.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "LCU Chrome Control"
  }
}
